# Supply-chain hardening: block dependency lifecycle scripts (preinstall/
# install/postinstall) — the primary execution vector for npm worms
# (Shai-Hulud, node-ipc, etc.). This frontend has NO dependency that requires an
# install script (verified via `npm query`; the Vite/esbuild/Rolldown toolchain
# ships prebuilt platform binaries as optionalDependencies, not via postinstall),
# so this is zero-friction — `npm install && npm run build` is unaffected.
#
# If a future dependency legitimately needs an install script, add it to a
# reviewed allowlist (e.g. @lavamoat/allow-scripts) rather than removing this.
ignore-scripts=true
