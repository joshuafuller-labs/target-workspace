{
  "name": "target-workspace-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "test": "TZ=America/New_York vitest run",
    "test:watch": "TZ=America/New_York vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@cesium/engine": "26.2.0",
    "@cesium/widgets": "15.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@tanstack/react-query": "5.102.8",
    "cesium": "^1.144.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resium": "1.25.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.6"
